# The worker Job for one attempt of an item run (014; contracts/worker-io.md). Unlike the
# fixture's worker-job.yaml.tmpl, its inputs (a repository snapshot can exceed a ConfigMap's
# 1 MiB) arrive through the `receiver` init container: the pilot streams a tar into /stage, then
# creates /stage/.ready, and the worker starts with /in read-only.
apiVersion: batch/v1
kind: Job
metadata: {name: worker, namespace: ${NS}}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: ${DEADLINE}
  template:
    metadata: {labels: {app: worker}}
    spec:
      serviceAccountName: worker
      automountServiceAccountToken: false
      enableServiceLinks: false
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile: {type: RuntimeDefault}
      initContainers:
        - name: receiver
          image: ${TOOLS_IMAGE}
          command: [sh, -c, "until [ -f /stage/.ready ]; do sleep 1; done"]
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          resources: {requests: {cpu: 50m, memory: 32Mi}, limits: {cpu: 500m, memory: 128Mi}}
          volumeMounts:
            - {name: inputs, mountPath: /stage}
${TOOLCHAIN_INITS}
      containers:
        - name: worker
          image: ${WORKER_IMAGE}
          env:
            - {name: PILOT_MODEL, value: "${PILOT_MODEL}"}
            - {name: PILOT_SPEND_CAP_USD, value: "${SPEND_CAP}"}
            - {name: PILOT_TOKEN_CAP, value: "${TOKEN_CAP}"}
            - {name: HTTPS_PROXY, value: "${PROXY_URL}"}
            - {name: https_proxy, value: "${PROXY_URL}"}
            - {name: NO_PROXY, value: ""}
${TOOLCHAIN_ENV}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          resources: {requests: {cpu: 500m, memory: 512Mi}, limits: {cpu: "${CPU}", memory: ${MEMORY}}}
          volumeMounts:
            - {name: inputs, mountPath: /in, readOnly: true}
            - {name: work, mountPath: /work}
            - {name: home, mountPath: /home/worker}
            - {name: model-key, mountPath: /home/worker/.config/opencode, readOnly: true}
            - {name: tmp, mountPath: /tmp}
${TOOLCHAIN_MOUNTS}
      volumes:
        - {name: inputs, emptyDir: {sizeLimit: ${INPUT_LIMIT}}}
        - {name: work, emptyDir: {sizeLimit: 1Gi}}
        - {name: home, emptyDir: {sizeLimit: ${HOME_LIMIT}}}
        - {name: model-key, secret: {secretName: model-key, defaultMode: 0440}}
        - {name: tmp, emptyDir: {sizeLimit: 1Gi}}
${TOOLCHAIN_VOLUMES}
