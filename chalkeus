#!/usr/bin/env bash
# Chalkeus in this repository (specs/027-chalkeus-rename): ./chalkeus forge <cmd>.
# Builds the binary on first use, and again whenever a Go source or module file is newer.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
export PATH="$HOME/.local/bin:$HOME/.local/go/bin:$PATH"

BIN="$ROOT/pilot/.build/bin/chalkeus"
if ! command -v go >/dev/null 2>&1; then
  echo "chalkeus: the Go toolchain is needed to build Chalkeus; see docs/operator-guide.md section 4" >&2
  exit 2
fi
if [ ! -x "$BIN" ] || [ -n "$(find cmd internal go.mod go.sum -newer "$BIN" -print -quit 2>/dev/null)" ]; then
  mkdir -p "$(dirname "$BIN")"
  VERSION="$(git describe --tags --always --dirty 2>/dev/null || echo dev)"
  go build -trimpath -ldflags "-X main.version=$VERSION" -o "$BIN" ./cmd/chalkeus
fi
exec "$BIN" "$@"
